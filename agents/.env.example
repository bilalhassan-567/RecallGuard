# Copy this file to agents/.env and fill in your real key. .env is gitignored — never commit it.

# From https://aistudio.google.com — "Get API key". No GCP billing account required.
GOOGLE_API_KEY=

# Tells the Gemini SDK / ADK to talk to the Gemini Developer API (AI Studio key) instead
# of Vertex AI. Flip this to TRUE later once the GCP billing/project side is unblocked
# and we want the agents running through Vertex AI instead.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Hackathon requires Gemini 3.5+. Flash is the default per Google's own cost guidance —
# reserve Pro for steps that need heavier reasoning (see docs/PLAN.md).
GEMINI_MODEL=gemini-3.5-flash
